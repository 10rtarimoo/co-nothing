    const difficultyConfig = {
      easy: { time: 60, count: 8 },
      normal: { time: 75, count: 10 },
      hard: { time: 90, count: 12 }
    };

    const state = {
      playerName: "",
      difficulty: "normal",
      sound: true,
      timeLeft: 0,
      score: 0,
      questionIndex: 0,
      correctCount: 0,
      solvedCount: 0,
      streak: 0,
      bestStreak: 0,
      questions: [],
      selectedAttack: null,
      selectedDefense: null,
      timerId: null,
      locked: false,
      startedAt: null
    };

    const $ = (id) => document.getElementById(id);

    const els = {
      playerName: $("playerName"),
      difficulty: $("difficulty"),
      soundToggle: $("soundToggle"),
      startBtn: $("startBtn"),
      resetRankBtn: $("resetRankBtn"),
      timeText: $("timeText"),
      scoreText: $("scoreText"),
      progressText: $("progressText"),
      streakText: $("streakText"),
      welcomeScreen: $("welcomeScreen"),
      gameScreen: $("gameScreen"),
      resultScreen: $("resultScreen"),
      questionTag: $("questionTag"),
      questionText: $("questionText"),
      attackOptions: $("attackOptions"),
      defenseOptions: $("defenseOptions"),
      submitBtn: $("submitBtn"),
      skipBtn: $("skipBtn"),
      feedbackBox: $("feedbackBox"),
      progressBar: $("progressBar"),
      finalScore: $("finalScore"),
      finalCorrect: $("finalCorrect"),
      finalSolved: $("finalSolved"),
      finalAccuracy: $("finalAccuracy"),
      finalStreak: $("finalStreak"),
      resultTitle: $("resultTitle"),
      rankingList: $("rankingList"),
      previewRankingList: $("previewRankingList"),
      scoreRing: $("scoreRing"),
      restartBtn: $("restartBtn")
    };

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function setScreen(screenName) {
      [els.welcomeScreen, els.gameScreen, els.resultScreen].forEach(el => el.classList.remove("active"));
      els[screenName].classList.add("active");
    }

    function updateHud() {
      els.timeText.textContent = `${state.timeLeft}s`;
      els.scoreText.textContent = state.score;
      els.progressText.textContent = `${Math.min(state.questionIndex + 1, state.questions.length)} / ${state.questions.length}`;
      els.streakText.textContent = state.streak;
      const progress = state.questions.length ? ((state.questionIndex) / state.questions.length) * 100 : 0;
      els.progressBar.style.width = `${progress}%`;
    }

    function renderOptions(container, options, selectedValue, type) {
      container.innerHTML = "";
      options.forEach(option => {
        const btn = document.createElement("button");
        btn.className = "option" + (selectedValue === option ? " selected" : "");
        btn.textContent = option;
        btn.disabled = state.locked;
        btn.addEventListener("click", () => {
          if (state.locked) return;
          if (type === "attack") state.selectedAttack = option;
          if (type === "defense") state.selectedDefense = option;
          renderCurrentQuestion();
          playTone(620, 0.03, 0.015);
        });
        container.appendChild(btn);
      });
    }

    function renderCurrentQuestion() {
      const q = state.questions[state.questionIndex];
      if (!q) return endGame();
      els.questionTag.textContent = `${q.title} · ${state.questionIndex + 1}번`;
      els.questionText.textContent = q.text;
      renderOptions(els.attackOptions, ATTACK_OPTIONS, state.selectedAttack, "attack");
      renderOptions(els.defenseOptions, DEFENSE_OPTIONS, state.selectedDefense, "defense");
      els.feedbackBox.className = "feedback";
      els.feedbackBox.textContent = "";
      updateHud();
    }

    function nextQuestion() {
      state.questionIndex += 1;
      state.selectedAttack = null;
      state.selectedDefense = null;
      state.locked = false;
      if (state.questionIndex >= state.questions.length) {
        endGame();
      } else {
        renderCurrentQuestion();
      }
    }

    function submitAnswer() {
      if (state.locked) return;
      if (!state.selectedAttack || !state.selectedDefense) {
        showFeedback("공격 유형과 방어 방법을 모두 선택해 주세요.", false);
        playTone(200, 0.08, 0.02);
        return;
      }

      const q = state.questions[state.questionIndex];
      state.locked = true;
      state.solvedCount += 1;

      const attackCorrect = state.selectedAttack === q.attack;
      const defenseCorrect = state.selectedDefense === q.defense;
      const bothCorrect = attackCorrect && defenseCorrect;

      const timeBonus = Math.max(0, Math.floor(state.timeLeft * 0.2));
      let gained = 0;
      if (bothCorrect) {
        gained = 20 + timeBonus;
        state.correctCount += 1;
        state.streak += 1;
        state.bestStreak = Math.max(state.bestStreak, state.streak);
      } else if (attackCorrect || defenseCorrect) {
        gained = 8;
        state.streak = 0;
      } else {
        gained = 0;
        state.streak = 0;
      }
      state.score += gained;

      markOptions(els.attackOptions, q.attack, state.selectedAttack);
      markOptions(els.defenseOptions, q.defense, state.selectedDefense);

      const msg = bothCorrect
        ? `정답입니다! +${gained}점\n${q.explanation}`
        : `부분 정답 또는 오답입니다. +${gained}점\n정답 공격: ${q.attack} / 정답 방어: ${q.defense}\n${q.explanation}`;

      showFeedback(msg, bothCorrect);
      updateHud();
      playTone(bothCorrect ? 740 : 280, 0.12, 0.03);

      setTimeout(nextQuestion, 1800);
    }

    function skipQuestion() {
      if (state.locked) return;
      state.streak = 0;
      playTone(180, 0.08, 0.02);
      nextQuestion();
    }

    function markOptions(container, correctValue, selectedValue) {
      [...container.children].forEach(btn => {
        const value = btn.textContent;
        btn.disabled = true;
        if (value === correctValue) btn.classList.add("correct");
        if (value === selectedValue && value !== correctValue) btn.classList.add("wrong");
      });
    }

    function showFeedback(text, isGood) {
      els.feedbackBox.textContent = text;
      els.feedbackBox.className = `feedback show ${isGood ? "good" : "bad"}`;
    }

    function startTimer() {
      clearInterval(state.timerId);
      state.timerId = setInterval(() => {
        state.timeLeft -= 1;
        updateHud();
        if (state.timeLeft <= 5 && state.timeLeft > 0) playTone(420, 0.03, 0.01);
        if (state.timeLeft <= 0) endGame();
      }, 1000);
    }

    function startGame() {
      state.playerName = els.playerName.value.trim() || "플레이어";
      state.difficulty = els.difficulty.value;
      state.sound = els.soundToggle.value === "on";
      const config = difficultyConfig[state.difficulty];
      state.timeLeft = config.time;
      state.score = 0;
      state.questionIndex = 0;
      state.correctCount = 0;
      state.solvedCount = 0;
      state.streak = 0;
      state.bestStreak = 0;
      state.selectedAttack = null;
      state.selectedDefense = null;
      state.locked = false;
      state.startedAt = Date.now();
      state.questions = shuffle(QUESTION_BANK).slice(0, config.count);
      setScreen("gameScreen");
      renderCurrentQuestion();
      updateHud();
      startTimer();
      playTone(520, 0.08, 0.03);
    }

    function endGame() {
      clearInterval(state.timerId);
      const accuracy = state.solvedCount ? Math.round((state.correctCount / state.solvedCount) * 100) : 0;
      const elapsed = state.startedAt ? Math.round((Date.now() - state.startedAt) / 1000) : 0;

      saveRanking({
        name: state.playerName,
        score: state.score,
        correct: state.correctCount,
        solved: state.solvedCount,
        accuracy,
        bestStreak: state.bestStreak,
        difficulty: state.difficulty,
        elapsed,
        date: new Date().toLocaleString("ko-KR")
      });

      els.resultTitle.textContent = `${state.playerName}님의 도전 결과`;
      els.finalScore.textContent = state.score;
      els.finalCorrect.textContent = state.correctCount;
      els.finalSolved.textContent = state.solvedCount;
      els.finalAccuracy.textContent = `${accuracy}%`;
      els.finalStreak.textContent = state.bestStreak;

      const percent = Math.min(100, Math.max(5, state.score));
      els.scoreRing.style.background = `conic-gradient(var(--neon) ${percent * 3.6}deg, rgba(255,255,255,0.08) 0deg)`;

      renderRanking();
      setScreen("resultScreen");
      playTone(660, 0.12, 0.04);
    }

    function getRanking() {
      return JSON.parse(localStorage.getItem("securityGameRanking") || "[]");
    }

    function saveRanking(record) {
      const ranking = getRanking();
      ranking.push(record);
      ranking.sort((a, b) => b.score - a.score || b.correct - a.correct || a.elapsed - b.elapsed);
      localStorage.setItem("securityGameRanking", JSON.stringify(ranking.slice(0, 10)));
    }

    function renderRanking() {
      const ranking = getRanking();
      const html = ranking.length
        ? ranking.map((item, index) => `
          <div class="ranking-item">
            <div class="rank-badge">${index + 1}</div>
            <div>
              <div><strong>${escapeHtml(item.name)}</strong> <span class="mini">· ${difficultyLabel(item.difficulty)} · ${item.date}</span></div>
              <div class="mini">정답 ${item.correct}개 / 해결 ${item.solved}문제 / 정확도 ${item.accuracy}% / 최고 연속 ${item.bestStreak}</div>
            </div>
            <div><strong>${item.score}점</strong></div>
          </div>`).join("")
        : '<div class="mini">아직 저장된 기록이 없습니다.</div>';
      els.rankingList.innerHTML = html;
      els.previewRankingList.innerHTML = html;
    }

    function difficultyLabel(value) {
      return value === "easy" ? "쉬움" : value === "hard" ? "어려움" : "보통";
    }

    function escapeHtml(str) {
      return str
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function resetRanking() {
      if (!confirm("저장된 랭킹 기록을 모두 지울까요?")) return;
      localStorage.removeItem("securityGameRanking");
      renderRanking();
    }

    function playTone(freq = 440, duration = 0.08, gainValue = 0.02) {
      if (!state.sound) return;
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtx) return;
      if (!window.__securityAudioCtx) window.__securityAudioCtx = new AudioCtx();
      const ctx = window.__securityAudioCtx;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "sine";
      osc.frequency.value = freq;
      gain.gain.value = gainValue;
      osc.connect(gain);
      gain.connect(ctx.destination);
      const now = ctx.currentTime;
      gain.gain.setValueAtTime(gainValue, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
      osc.start(now);
      osc.stop(now + duration);
    }

    els.startBtn.addEventListener("click", startGame);
    els.submitBtn.addEventListener("click", submitAnswer);
    els.skipBtn.addEventListener("click", skipQuestion);
    els.restartBtn.addEventListener("click", () => {
      setScreen("welcomeScreen");
      updateHud();
      renderRanking();
    });
    els.resetRankBtn.addEventListener("click", resetRanking);

    renderRanking();
    updateHud();
  </script>
